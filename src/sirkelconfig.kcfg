<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE kcfg SYSTEM "http://www.kde.org/standards/kcfg/1.0/kcfg.dtd">
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name="kwinrc"/>
  <group name="Effect-sirkel">
    <!-- Pointer displacement (px) from the hyperkey-press position required
         before a horizontal direction (left/right) is armed. -->
    <entry name="HorizontalDeadzone" type="Int">
      <default>48</default>
    </entry>
    <!-- Pointer displacement (px) required before a vertical direction
         (top/bottom, or tipping a horizontal pick into a corner) is armed. -->
    <entry name="VerticalDeadzone" type="Int">
      <default>48</default>
    </entry>
    <!-- Gap (px) left on the left/right edges of a snapped window. -->
    <entry name="PaddingHorizontal" type="Int">
      <default>0</default>
    </entry>
    <!-- Gap (px) left on the top/bottom edges of a snapped window. -->
    <entry name="PaddingVertical" type="Int">
      <default>0</default>
    </entry>
    <!-- Diameter (px) of the center direction indicator. -->
    <entry name="IndicatorSize" type="Int">
      <default>120</default>
    </entry>
    <!-- Corner radius (px) of the small center direction indicator ring.
         0 = square frame, half of IndicatorSize = full circle. -->
    <entry name="IndicatorCornerRadius" type="Int">
      <default>60</default>
    </entry>
    <!-- Ring thickness (px) of the center direction indicator. -->
    <entry name="IndicatorRingWidth" type="Int">
      <default>24</default>
    </entry>
    <!-- Length (px) of the sliding pointer/marker along the indicator
         ring's own curve. Its thickness always matches IndicatorRingWidth
         (the pointer fills the ring it rides on, not an independent size). -->
    <entry name="IndicatorPointerLength" type="Int">
      <default>36</default>
    </entry>
    <!-- Whether the center indicator shows the direction name as text. -->
    <entry name="ShowIndicatorText" type="Bool">
      <default>false</default>
    </entry>
    <!-- Border thickness (px) of the target-outline preview. -->
    <entry name="OutlineBorderWidth" type="Int">
      <default>2</default>
    </entry>
    <!-- Corner radius (px) of the target-outline preview. -->
    <entry name="OutlineCornerRadius" type="Int">
      <default>4</default>
    </entry>
    <!-- Opacity (0-100) of a translucent fill inside the target-outline
         preview, in addition to its border. 0 = no fill (unchanged look). -->
    <entry name="OutlineFillOpacity" type="Int">
      <default>20</default>
    </entry>
    <!-- How long (ms) the target-outline preview takes to glide/resize
         between directions. 0 = instant (snaps straight to the new
         position/size, the original behavior). -->
    <entry name="OutlineAnimationDuration" type="Int">
      <default>75</default>
    </entry>
    <!-- Border/highlight color of the target-outline preview and the
         selected segment of the center indicator ring. Alpha channel is
         respected (KConfig's Color type round-trips it natively). This
         static fallback is effectively never seen in practice: as long as
         no value has ever been explicitly saved (checked via
         config()->group(...).hasKey("OutlineColor"), not this default),
         SirkelEffect::applyIndicatorStyle() and
         SirkelConfigModule::outlineColor() both substitute the live theme
         accent color (QGuiApplication::palette().color(QPalette::Highlight))
         instead — see resolveOutlineColor() in each. -->
    <entry name="OutlineColor" type="Color">
      <default>61,174,233</default>
    </entry>
    <!-- Which key scheme selects a cardinal direction while armed. -->
    <entry name="KeybindScheme" type="String">
      <default>arrows</default>
    </entry>
    <!-- Whether the center direction indicator is shown at all. -->
    <entry name="ShowIndicator" type="Bool">
      <default>true</default>
    </entry>
    <!-- Whether the target-outline preview is shown at all. -->
    <entry name="ShowOutline" type="Bool">
      <default>true</default>
    </entry>
    <!-- Whether the center indicator tracks the live cursor position
         instead of staying fixed at the screen's center. -->
    <entry name="IndicatorFollowsMouse" type="Bool">
      <default>false</default>
    </entry>
  </group>
</kcfg>
